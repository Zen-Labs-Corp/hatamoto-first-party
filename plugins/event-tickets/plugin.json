{
  "name": "event-tickets",
  "version": "0.6.0",
  "sdk": "^0.22.2",
  "description": "Free and paid tickets (Stripe, PayPal), RSVP, coupons, attendees and event emails for the event-calendar plugin.",
  "permissions": ["settings", "db", "entities.read", "mail.send", "http.fetch", "builder.data", "builder.island"],
  "allowed_hosts": ["api.stripe.com", "api-m.paypal.com", "api-m.sandbox.paypal.com"],
  "request_headers": ["stripe-signature", "paypal-transmission-id", "paypal-transmission-time", "paypal-transmission-sig", "paypal-cert-url", "paypal-auth-algo"],
  "ui": { "title": "Event tickets", "entry": "index.html", "roles": ["owner", "editor"], "allow": ["camera"] },
  "builder_sources": [
    { "name": "tickets", "label": "Tickets of this event", "kind": "items" }
  ],
  "limits": {
    "memory_pages": 256,
    "max_instances": 4,
    "max_output_bytes": 2097152,
    "hook_timeouts_ms": {
      "entity.created": 5000,
      "entity.updated": 5000,
      "entity.published": 5000,
      "entity.deleted": 5000,
      "builder.data": 450,
      "on_cron_mail": 10000,
      "on_cron_maintain": 10000,
      "on_cron_emails": 10000
    }
  },
  "routes": [
    { "method": "GET", "path": "/admin/events", "roles": ["owner", "editor"] },
    { "method": "GET", "path": "/admin/events/{id}", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/events/{id}/types", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/types/{id}/delete", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/events/{id}/fields", "roles": ["owner", "editor"] },
    { "method": "GET", "path": "/admin/events/{id}/attendees", "roles": ["owner", "editor"] },
    { "method": "GET", "path": "/admin/events/{id}/attendees.csv", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/attendees/{id}/resend", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/attendees/{id}/cancel", "roles": ["owner", "editor"] },
    { "method": "GET", "path": "/admin/settings", "roles": ["owner", "editor"] },
    { "method": "GET", "path": "/token", "public": true },
    { "method": "POST", "path": "/rsvp", "public": true },
    { "method": "GET", "path": "/waitlist/{token}/claim", "public": true },
    { "method": "GET", "path": "/waitlist/{token}/leave", "public": true },
    { "method": "GET", "path": "/ticket/{token}", "public": true },
    { "method": "GET", "path": "/ticket/{token}/qr.png", "public": true },
    { "method": "POST", "path": "/quote", "public": true },
    { "method": "POST", "path": "/checkout", "public": true },
    { "method": "POST", "path": "/stripe/webhook", "public": true },
    { "method": "POST", "path": "/paypal/webhook", "public": true },
    { "method": "GET", "path": "/return/{token}", "public": true },
    { "method": "GET", "path": "/cancel/{token}", "public": true },
    { "method": "GET", "path": "/admin/orders", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/orders/{id}/refund", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/orders/{id}/cancel", "roles": ["owner"] },
    { "method": "GET", "path": "/admin/coupons", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/coupons", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/coupons/{id}/delete", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/events/{id}/bundles", "roles": ["owner"] },
    { "method": "GET", "path": "/admin/events/{id}/checkin", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/events/{id}/checkin", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/attendees/{id}/uncheck", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/events/{id}/splits", "roles": ["owner"] },
    { "method": "GET", "path": "/admin/payouts", "roles": ["owner"] },
    { "method": "GET", "path": "/admin/payouts.csv", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/payouts/mark", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/payouts/unmark", "roles": ["owner"] },
    { "method": "GET", "path": "/admin/emails", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/emails/automations", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/campaigns/count", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/campaigns", "roles": ["owner"] },
    { "method": "POST", "path": "/admin/campaigns/{id}/cancel", "roles": ["owner"] },
    { "method": "GET", "path": "/o/{token}", "public": true },
    { "method": "GET", "path": "/c/{token}", "public": true },
    { "method": "GET", "path": "/u/{token}", "public": true },
    { "method": "GET", "path": "/admin/maps", "roles": ["owner", "editor"] },
    { "method": "GET", "path": "/admin/maps/{id}", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/maps", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/maps/{id}/delete", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/maps/{id}/sections", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/sections/{id}/delete", "roles": ["owner", "editor"] },
    { "method": "POST", "path": "/admin/sections/{id}/seats", "roles": ["owner", "editor"] },
    { "method": "GET", "path": "/seats/{event}", "public": true },
    { "method": "POST", "path": "/seats/hold", "public": true },
    { "method": "DELETE", "path": "/seats/hold/{token}", "public": true }
  ],
  "cron": [
    { "name": "mail", "every": "5m" },
    { "name": "maintain", "every": "1h" },
    { "name": "emails", "every": "5m" }
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "currency": {
        "type": "string",
        "title": "Currency",
        "description": "Three-letter currency code of ticket prices, for example USD or EUR.",
        "default": "USD",
        "pattern": "^[A-Z]{3}$"
      },
      "sender_name": {
        "type": "string",
        "title": "Sender name",
        "description": "Signs the emails sent to attendees, for example the name of your organisation. Leave empty to sign with the site name.",
        "default": "",
        "maxLength": 80
      },
      "confirmation_text": {
        "type": "string",
        "title": "Confirmation message",
        "description": "Extra text added to every confirmation email, for example how to find the entrance. Leave empty to add nothing.",
        "default": "",
        "maxLength": 2000
      },
      "default_capacity": {
        "type": "integer",
        "title": "Default number of tickets",
        "description": "Pre-filled when you add a ticket type to an event.",
        "default": 50,
        "minimum": 1,
        "maximum": 100000
      },
      "retention_months": {
        "type": "integer",
        "title": "Keep attendee details for (months)",
        "description": "Names and email addresses are erased this many months after the event ended. Ticket counts stay.",
        "default": 24,
        "minimum": 1,
        "maximum": 120
      },
      "site_url": {
        "type": "string",
        "title": "Site address",
        "description": "Address of the site, used for QR images in emails when the event address is a path only",
        "default": "",
        "maxLength": 200,
        "pattern": "^(https?://[^\\s/]+)?$"
      },
      "schema_slug": {
        "type": "string",
        "title": "Event content type",
        "description": "Leave empty to use Calendar event and any older Event type. Or name one content type.",
        "default": "",
        "pattern": "^([a-z][a-z0-9_-]{0,63})?$"
      },
      "stripe_secret_key": {
        "type": "string",
        "title": "Stripe secret key",
        "description": "A secret or restricted key from your Stripe dashboard (sk_ or rk_). Stored here and never shown again.",
        "default": "",
        "writeOnly": true,
        "pattern": "^$|^(sk|rk)_(test|live)_[A-Za-z0-9]{10,200}$"
      },
      "stripe_webhook_secret": {
        "type": "string",
        "title": "Stripe webhook signing secret",
        "description": "The signing secret (whsec_) of the webhook endpoint you added in Stripe. Stored here and never shown again.",
        "default": "",
        "writeOnly": true,
        "pattern": "^$|^whsec_[A-Za-z0-9]{10,200}$"
      },
      "paypal_client_id": {
        "type": "string",
        "title": "PayPal client ID",
        "description": "From a REST app in your PayPal developer dashboard. Leave empty to not offer PayPal.",
        "default": "",
        "maxLength": 200
      },
      "paypal_secret": {
        "type": "string",
        "title": "PayPal secret",
        "description": "The secret of the same REST app. Stored here and never shown again.",
        "default": "",
        "writeOnly": true,
        "maxLength": 200
      },
      "paypal_webhook_id": {
        "type": "string",
        "title": "PayPal webhook ID",
        "description": "The ID of the webhook you added to the REST app. Without it PayPal payments are still completed when the buyer returns to your site.",
        "default": "",
        "pattern": "^$|^[A-Z0-9]{8,40}$"
      },
      "paypal_sandbox": {
        "type": "boolean",
        "title": "PayPal test mode",
        "description": "Use the PayPal sandbox instead of the live service. Turn it off to take real payments.",
        "default": false
      },
      "fee_fixed_cents": {
        "type": "integer",
        "title": "Fixed fee (smallest currency unit)",
        "description": "A fixed fee on paid orders in the smallest unit of the currency, for example 30 for 0.30 USD. 0 for none.",
        "default": 0,
        "minimum": 0,
        "maximum": 100000
      },
      "fee_percent_bp": {
        "type": "integer",
        "title": "Percentage fee (hundredths of a percent)",
        "description": "A percentage fee on paid orders in hundredths of a percent: 250 is 2.5 %. 0 for none.",
        "default": 0,
        "minimum": 0,
        "maximum": 5000
      },
      "fee_per": {
        "type": "string",
        "title": "Fixed fee applies per",
        "description": "Charge the fixed fee once per order, or once per paid ticket.",
        "enum": ["order", "ticket"],
        "default": "order"
      },
      "fee_payer": {
        "type": "string",
        "title": "Who pays the fee",
        "description": "The buyer pays it on top of the ticket prices, or you absorb it and the buyer pays the ticket prices only.",
        "enum": ["buyer", "organizer"],
        "default": "buyer"
      }
    }
  }
}
