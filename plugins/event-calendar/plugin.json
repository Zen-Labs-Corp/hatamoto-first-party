{
  "name": "event-calendar",
  "version": "0.4.0",
  "sdk": "^0.21",
  "description": "Events with dates, venue and ticket link: upcoming and past lists for the page builder, an iCal feed and Event structured data.",
  "permissions": [
    "entities.read",
    "builder.data",
    "settings",
    "db",
    "http.fetch",
    "builder.island"
  ],
  "allowed_hosts": [
    "nominatim.openstreetmap.org"
  ],
  "builder_sources": [
    {
      "name": "upcoming",
      "label": "Upcoming events",
      "kind": "items",
      "params": [
        {
          "name": "category",
          "label": "Category",
          "type": "text"
        },
        {
          "name": "venue",
          "label": "Venue",
          "type": "text"
        },
        {
          "name": "city",
          "label": "City",
          "type": "text"
        },
        {
          "name": "free",
          "label": "Free events only",
          "type": "bool"
        }
      ]
    },
    {
      "name": "past",
      "label": "Past events",
      "kind": "items",
      "params": [
        {
          "name": "category",
          "label": "Category",
          "type": "text"
        },
        {
          "name": "venue",
          "label": "Venue",
          "type": "text"
        },
        {
          "name": "city",
          "label": "City",
          "type": "text"
        },
        {
          "name": "free",
          "label": "Free events only",
          "type": "bool"
        }
      ]
    },
    {
      "name": "event",
      "label": "This event",
      "kind": "items"
    }
  ],
  "funcs": [
    "when",
    "addlink"
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/events.ics",
      "public": true
    },
    {
      "method": "GET",
      "path": "/event/{file}",
      "public": true
    },
    {
      "method": "GET",
      "path": "/api/events",
      "public": true
    },
    {
      "method": "GET",
      "path": "/series/{slug}",
      "public": true
    },
    {
      "method": "GET",
      "path": "/venue/{slug}",
      "public": true
    },
    {
      "method": "GET",
      "path": "/organizer/{slug}",
      "public": true
    },
    {
      "method": "GET",
      "path": "/admin/repeating",
      "roles": [
        "owner",
        "editor"
      ]
    }
  ],
  "ui": {
    "title": "Repeating events",
    "entry": "index.html",
    "roles": [
      "owner",
      "editor"
    ]
  },
  "runs": [
    {
      "name": "edit_dates",
      "title": "Edit repeat dates",
      "inputs": [
        {
          "name": "event",
          "label": "Event (slug)",
          "type": "text",
          "required": true
        },
        {
          "name": "action",
          "label": "Action",
          "type": "select",
          "options": [
            "skip",
            "change",
            "restore"
          ],
          "required": true
        },
        {
          "name": "date",
          "label": "Date (YYYY-MM-DD)",
          "type": "text",
          "required": true
        },
        {
          "name": "start_at",
          "label": "New start (for change, like 18:30)",
          "type": "text"
        },
        {
          "name": "end_at",
          "label": "New end (for change, like 20:00)",
          "type": "text"
        }
      ],
      "stages": [
        "fetch",
        "transform"
      ]
    },
    {
      "name": "duplicate",
      "title": "Duplicate event",
      "inputs": [
        {
          "name": "event",
          "label": "Event (slug)",
          "type": "text",
          "required": true
        },
        {
          "name": "shift_days",
          "label": "Move dates by (days)",
          "type": "number"
        }
      ],
      "stages": [
        "fetch",
        "transform"
      ]
    }
  ],
  "limits": {
    "memory_pages": 256,
    "max_instances": 4,
    "max_output_bytes": 2097152,
    "hook_timeouts_ms": {
      "builder.data": 450,
      "jsonld.enrich": 500,
      "func_when": 250,
      "func_addlink": 250,
      "entity.created": 5000,
      "entity.updated": 5000,
      "entity.published": 5000,
      "entity.deleted": 5000,
      "import.completed": 10000,
      "on_cron_reconcile": 10000,
      "on_run_step": 10000
    }
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "schema_slug": {
        "type": "string",
        "title": "Event content type",
        "description": "Leave empty to use Calendar event and any older Event type. Or name one content type.",
        "default": "",
        "pattern": "^([a-z][a-z0-9_-]{0,63})?$"
      },
      "time_zone": {
        "type": "string",
        "title": "Time zone",
        "description": "IANA name of the zone the stored event times are in and the zone dates are shown in, for example Europe/London. An unknown name means UTC.",
        "default": "UTC"
      },
      "date_format": {
        "type": "string",
        "title": "Date format",
        "description": "How dates read: Sat 14 Feb, Sat, Feb 14 or 2026-02-14.",
        "enum": [
          "short",
          "us",
          "iso"
        ],
        "default": "short"
      },
      "week_starts_on": {
        "type": "string",
        "title": "Week starts on",
        "description": "The first day of the week in the calendar widgets.",
        "enum": [
          "monday",
          "sunday"
        ],
        "default": "monday"
      },
      "show_map": {
        "type": "boolean",
        "title": "Show map",
        "description": "Show an OpenStreetMap map on event pages. Looks up venue addresses with Nominatim (cached, one request per second).",
        "default": false
      },
      "geocode_contact": {
        "type": "string",
        "title": "Nominatim contact",
        "description": "Email or web address added to the lookup User-Agent, as the Nominatim usage policy asks.",
        "default": ""
      }
    }
  },
  "cron": [
    {
      "name": "reconcile",
      "every": "1h"
    }
  ]
}
